# Select a profile or override individual fields.
HOS_PROVIDER=custom
# HOS_CONFIG=C:\path\to\hos.toml
# HOS_BASE_URL=https://override.example/v1
# HOS_ENDPOINT=/chat/completions
# HOS_MODEL=override-model-id
# HOS_API_KEY=optional-direct-key-override

# Profile-specific secrets referenced by hos.example.toml.
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_TENANT_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ARC-AGI-3 is optional. Anonymous access is used when unset.
ARC_API_KEY=

# Local ARC-AGI-3 environment directory.
# Use forward slashes on Windows, for example D:/guan/environment_files.
ARC_ENVIRONMENTS_DIR=environment_files
# ENVIRONMENTS_DIR=environment_files

# Set this only for offline ARC runs. arc3-local already forces offline mode.
# OPERATION_MODE=offline

# Lifecycle logs go to stderr. DEBUG also prints every Host Protocol call.
# Use INFO to disable DEBUG call-level logs; use OFF to disable HOS logs.
HOS_LOG_LEVEL=DEBUG

# Runtime selection. "llm" sends requests to the configured provider profiles.
# HOS_RUNTIME=llm
# HOS_TASK_PROVIDER=task
# HOS_META_PROVIDER=meta
