# Copy to .env in this repository. External benchmark checkout .env files are not read.
OPENAI_API_BASE=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=replace-me
EXEC_MODEL=a:deepseek-v4-flash

# Optional ARC-only overrides. ARC defaults to the official Responses API
# contract and gpt-5.6-sol; these do not affect OfficeBench/Shopping/Terminal.
ARC_OPENAI_API_BASE=https://yibuapi.com/v1
ARC_OPENAI_API_KEY=replace-me
ARC_MODEL=gpt-5.6-sol
ARC_PI_API=openai-responses

# External benchmark locations (all are treated as read-only inputs).
JIT_ROOT=D:/JIT
JIT_PYTHON=D:/anaconda/envs/jit/python.exe
ARC_AGI_3_ROOT=D:/arc-agi-benchmark/arc-agi-3-benchmarking
TERMINAL_BENCH_ROOT=D:/terminal-bench
TERMINAL_BENCH_DATASET=D:/terminal-bench-2-1

# ARC-AGI-3 official online environment credential. Required only for ARC runs.
ARC_API_KEY=replace-me
