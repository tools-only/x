# Copy the required values into a local .env file. Never commit real credentials.
OPENAI_API_BASE=https://your-az-compatible-endpoint/v1
OPENAI_API_KEY=replace-with-your-api-key
EXEC_MODEL=gpt-6-luna
ARC_PI_API=openai-completions

# Optional. Set this to a local ALE-Bench dataset directory containing
# problem_ids_lite.txt and the requested <problem-id>.zip.
ALE_BENCH_DATA=
